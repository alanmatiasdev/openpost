{
  "name": "openpost",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "trustedDependencies": [
    "@openpost/web",
    "esbuild",
    "sharp",
    "vue-demi",
    "workerd"
  ],
  "scripts": {
    "doctor": "bash scripts/dev-doctor.sh",
    "browser:install": "playwright install chromium",
    "sync:assets": "bun scripts/sync-assets.mjs",
    "generate:social-catalog": "bun scripts/social-images/catalog.mjs",
    "generate:social-assets": "bun social-assets/openpost/source/generate.mjs",
    "check:social-images": "bun scripts/social-images/catalog.mjs --check && bun test packages/social-images/src/index.test.mjs && bun run --filter @openpost/site build:functions",
    "sync:docs-external": "bun scripts/sync-docs-external.mjs",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "check": "bun run check:docs && bun run check:release-version && bun run check:app-routes && bun run check:changelog && bun run check:social-images && bun run check:ui-consistency && turbo run check",
    "check:contracts": "bun scripts/check-contracts.mjs",
    "check:docs": "bun scripts/check-doc-links.mjs",
    "check:release-version": "bun test scripts/next-release-version.test.mjs",
    "check:app-routes": "bun test scripts/generate-app-route-manifest.test.mjs && bun scripts/generate-app-route-manifest.mjs --check",
    "check:changelog": "bun scripts/check-changelog.mjs && bun test packages/changelog/src/index.test.mjs",
    "check:ui-consistency": "bun scripts/check-ui-consistency.mjs",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:app": "playwright test --config playwright.app.config.ts",
    "test:e2e:docs": "playwright test --config playwright.docs.config.ts",
    "benchmark:video-editor": "bash scripts/run-video-editor-benchmark.sh",
    "capture:product-screenshots": "OPENPOST_UPDATE_PRODUCT_SCREENSHOTS=1 OPENPOST_APP_E2E_PORT=18181 playwright test --config playwright.app.config.ts e2e-app/product-screenshots.spec.ts --workers=1",
    "release:plan": "devenv shell -- bun scripts/release.mjs plan",
    "release:preflight": "devenv shell -- bun scripts/release.mjs preflight",
    "release:check": "devenv shell -- bun scripts/release.mjs check",
    "release:status": "devenv shell -- bun scripts/release.mjs status",
    "release:prepare": "devenv shell -- bun scripts/release.mjs prepare",
    "release:promote": "devenv shell -- bun scripts/release.mjs promote",
    "release:prod": "devenv shell -- bun scripts/release.mjs prod",
    "lint": "turbo run lint",
    "docs:dev": "bun run sync:assets && bun run sync:docs-external && bun run --filter @openpost/docs docs:dev",
    "docs:build": "bun run sync:assets && bun run sync:docs-external && bun run --filter @openpost/docs docs:build",
    "docs:preview": "bun run --filter @openpost/docs docs:preview",
    "frontend:dev": "bun run --filter @openpost/web dev",
    "frontend:build": "bun run --filter @openpost/web build",
    "marketing:dev": "bun run sync:assets && bun run --filter @openpost/site dev",
    "marketing:build": "bun run sync:assets && bun run --filter @openpost/site build",
    "marketing:preview": "bun run --filter @openpost/site preview"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "turbo": "^2.6.3"
  },
  "workspaces": [
    "frontend",
    "docs-site",
    "marketing-site",
    "packages/*"
  ],
  "overrides": {
    "@sveltejs/kit": "2.70.2",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "cookie": "0.7.2",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.17",
    "postcss": "8.5.23",
    "sharp": "0.35.0",
    "tar": "7.5.22",
    "undici": "7.29.0",
    "vitest": "4.1.10"
  }
}
